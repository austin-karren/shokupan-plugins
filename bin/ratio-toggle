#!/usr/bin/env bash
#
# Waybar module for Ratio - Omarchy's single_window_aspect_ratio, which squares a
# lone tiled window instead of letting it span a wide screen. See ADR-0013.
#
#   ratio-toggle --status    print Waybar JSON for the current state
#   ratio-toggle             flip it, then refresh the bar
#
# ONE glyph, U+F2D0 (window-maximize) - the same one Omarchy puts in this toggle's own
# notifications, so the bar and the toast agree. State is carried by the `active` class
# and dimmed in CSS, not by a second glyph.
#
# A matched pair was tried first: U+F01A0 crop_landscape for off and U+F01A2 crop_square
# for on, so the glyph would show the shape a lone window takes. Rendered at the bar's
# real size it was clearly worse. Both are 1px outlines with almost no mass next to
# F2D0's filled title bar, and at 12px the two barely differ from each other - the
# aspect distinction that reads fine at 40px does not survive the shrink.
#
# No square sibling of F2D0 exists to fix that. Font Awesome's window family
# (F2D0..F2D3) is maximize/minimize/restore/close, none of them square; the nearest
# Material Design candidate, F05AE, is portrait with a small tab rather than a title
# bar, so pairing them reads as "window" versus "shutter".
#
# Using one glyph also means the module's footprint cannot change between states, so
# nothing on the bar can shift when it is toggled.

set -euo pipefail

FLAG="$HOME/.local/state/omarchy/toggles/hypr/single-window-aspect-ratio.conf"
# Signals 7-10 are taken by omarchy's own indicators.
SIGNAL=11

if [[ ${1-} == --status ]]; then
  if [[ -f $FLAG ]]; then
    printf '{"text":"","tooltip":"Ratio on\\n\\nA lone window is squared.\\nClick to turn off.","class":"active"}\n'
  else
    printf '{"text":"","tooltip":"Ratio off\\n\\nA lone window fills the screen.\\nClick to turn on."}\n'
  fi
  exit 0
fi

[[ -z ${1-} ]] || {
  echo "usage: ratio-toggle [--status]" >&2
  exit 1
}

# Omarchy's own toggle: copies the flag file in or out and reloads Hyprland. It does
# not touch Waybar, which is why the signal below is ours to send.
omarchy-hyprland-window-single-square-aspect-toggle
pkill -RTMIN+$SIGNAL waybar 2>/dev/null || true
