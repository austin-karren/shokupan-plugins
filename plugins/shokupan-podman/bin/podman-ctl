#!/bin/bash

# Helper for the shokupan.podman bar widget. Ported from the docker helper of
# io.github.dicemans.docker-vms (MIT, Paolo Pellicori) to rootless podman.
#
# The QML panel stays presentational: every podman call and client launch
# lives here so it can be read and fixed from a terminal. Parsing does NOT
# live here any more: `list` and `stats` hand podman's own JSON to Model.js,
# which is where it is tested (test/podman-model-test.mjs).
#
#   podman-ctl list                    podman ps -a JSON, bounded
#   podman-ctl stats                   podman stats JSON, bounded
#   podman-ctl start|restart|pause|unpause|kill <name>
#   podman-ctl stop <name> [timeout-seconds]
#   podman-ctl remove <name>           delete a container podman will let go
#   podman-ctl logs|shell <name>       terminal on the container
#   podman-ctl open <name> <host-port> browser on a published port
#   podman-ctl connect <name> [timeout] RDP session (dockur Windows VMs)
#   podman-ctl viewer <name>           web/VNC viewer in the default browser
#
# Rootless podman has no daemon and no socket permission to fix, so the
# docker plugin's polkit `daemon-start` path is gone: the CLI either runs or
# is not installed.

set -uo pipefail

RDP_CONTAINER_PORT=3389
WEB_CONTAINER_PORT=8006
DEFAULT_USER="docker"
DEFAULT_PASS="admin"
DEFAULT_STOP_TIMEOUT=60
DEFAULT_RDP_TIMEOUT=120
REMOVABLE_STATES="created exited stopped configured dead"

# Bytes accepted from one podman invocation. JSON cannot be cut mid-stream and
# still parse, so an oversized listing is refused with a code rather than
# truncated into something Model.js would reject anyway.
MAX_BYTES=1048576
MAX_DIAG=400
MAX_FIELD=512

die() {
  echo "${1:0:MAX_DIAG}" >&2
  exit 1
}

require_podman() {
  command -v podman >/dev/null 2>&1 || die "podman-missing"
}

# Run a JSON producer under a byte budget. One byte over the cap is read so
# "exactly at the cap" and "over it" are distinguishable.
bounded_json() {
  local out rc errfile
  errfile=$(mktemp) || die "podman-failed"
  out=$("$@" 2>"$errfile" | head -c $((MAX_BYTES + 1)); exit "${PIPESTATUS[0]}")
  rc=$?
  local err
  err=$(head -1 "$errfile")
  rm -f "$errfile"
  # Bytes, not characters: head -c counts bytes. Checked before the exit
  # status, because an over-cap producer dies of SIGPIPE.
  (($(printf '%s' "$out" | wc -c) > MAX_BYTES)) && die "list-too-large"
  ((rc == 0)) || die "${err:-podman-failed}"
  printf '%s\n' "$out"
}

cmd_list() {
  require_podman
  bounded_json podman ps -a --format json
}

# `podman stats --no-stream` samples twice a second apart, like docker's, so
# it stays on its own slower timer in the panel.
cmd_stats() {
  require_podman
  bounded_json podman stats --no-stream --format json
}

container_exists() {
  podman container exists "$1" 2>/dev/null
}

container_state() {
  podman inspect --format '{{.State.Status}}' "$1" 2>/dev/null
}

container_env() {
  local name="$1" key="$2" fallback="$3" value
  value=$(podman inspect --format '{{range .Config.Env}}{{println .}}{{end}}' "$name" 2>/dev/null \
    | sed -n "s/^${key}=//p" | head -1)
  echo "${value:-$fallback}"
}

# Host port for one container port, or 0. `podman port` prints
# "0.0.0.0:3389" per binding; the first one wins.
bound_port() {
  local value
  value=$(podman port "$1" "$2/tcp" 2>/dev/null | head -1)
  value="${value##*:}"
  [[ $value =~ ^[0-9]{1,5}$ ]] || value=0
  echo "$value"
}

launch_detached() {
  if command -v uwsm-app >/dev/null 2>&1; then
    uwsm-app -- "$@" >/dev/null 2>&1 &
  else
    setsid "$@" >/dev/null 2>&1 &
  fi
  disown 2>/dev/null
}

# Surface podman's own first error line instead of a generic code.
podman_do() {
  local fallback="$1"
  shift
  local err
  if err=$("$@" 2>&1 >/dev/null); then
    return 0
  fi
  err=$(printf '%s\n' "$err" | head -1)
  die "${err:-$fallback}"
}

need_container() {
  require_podman
  [[ -n ${1:-} ]] || die "no-container"
  container_exists "$1" || die "no-such-container"
}

cmd_lifecycle() {
  local action="$1" name="$2" timeout="${3:-}"
  need_container "$name"
  if [[ $action == "stop" ]]; then
    [[ $timeout =~ ^[0-9]+$ ]] || timeout=$DEFAULT_STOP_TIMEOUT
    podman_do "stop-failed" podman stop -t "$timeout" "$name"
  else
    podman_do "${action}-failed" podman "$action" "$name"
  fi
}

# Only a stopped container, never `-f` or `-v`: volumes and the image stay.
cmd_remove() {
  local name="$1"
  need_container "$name"
  local state
  state=$(container_state "$name")
  [[ " $REMOVABLE_STATES " == *" $state "* ]] || die "not-removable:$state"
  podman_do "remove-failed" podman rm "$name"
}

wait_for_rdp() {
  local port="$1" budget="${2:-$DEFAULT_RDP_TIMEOUT}" deadline
  deadline=$((SECONDS + budget))
  while ((SECONDS < deadline)); do
    timeout 2 bash -c "cat < /dev/null > /dev/tcp/127.0.0.1/$port" 2>/dev/null && return 0
    sleep 2
  done
  return 1
}

cmd_connect() {
  local name="$1" rdp_timeout="${2:-}"
  [[ $rdp_timeout =~ ^[0-9]+$ ]] || rdp_timeout=$DEFAULT_RDP_TIMEOUT
  need_container "$name"
  command -v xfreerdp3 >/dev/null 2>&1 || die "xfreerdp3-missing"

  local port
  port=$(bound_port "$name" "$RDP_CONTAINER_PORT")
  [[ $port != "0" ]] || die "no-rdp-port"

  if [[ $(container_state "$name") != "running" ]]; then
    podman start "$name" >/dev/null 2>&1 || die "start-failed"
  fi

  local user pass
  user=$(container_env "$name" USERNAME "$DEFAULT_USER")
  pass=$(container_env "$name" PASSWORD "$DEFAULT_PASS")
  wait_for_rdp "$port" "$rdp_timeout" || { unset pass; die "rdp-timeout"; }

  local -a args=(
    "/u:${user:0:MAX_FIELD}"
    "/p:$pass"
    "/v:127.0.0.1:$port"
    "-grab-keyboard" "/sound" "/microphone" "/clipboard" "/cert:ignore"
    "/title:${name:0:MAX_FIELD}"
    "/dynamic-resolution" "/gfx:AVC444"
    "/floatbar:sticky:off,default:visible,show:fullscreen"
  )
  # The password never reaches argv (/proc/<pid>/cmdline is world-readable):
  # xfreerdp3 reads its whole command line from the pipe.
  printf '%s\n' "${args[@]}" | setsid xfreerdp3 /args-from:stdin >/dev/null 2>&1 &
  disown 2>/dev/null
  unset pass args
}

open_url() {
  if command -v omarchy-launch-browser >/dev/null 2>&1; then
    launch_detached omarchy-launch-browser "$1"
  else
    launch_detached xdg-open "$1"
  fi
}

cmd_viewer() {
  local name="$1"
  need_container "$name"
  local port
  port=$(bound_port "$name" "$WEB_CONTAINER_PORT")
  [[ $port != "0" ]] || die "no-web-port"
  if [[ $(container_state "$name") != "running" ]]; then
    podman start "$name" >/dev/null 2>&1 || die "start-failed"
  fi
  open_url "http://127.0.0.1:$port"
}

cmd_open() {
  local name="$1" port="$2"
  # [1-9] first: a leading zero would be read as octal by (( )).
  [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && ((port < 65536)) || die "bad-port"
  need_container "$name"
  [[ $(container_state "$name") == "running" ]] || die "container-not-running"
  open_url "http://127.0.0.1:$port"
}

# The container name goes in as a positional argument, never interpolated,
# so no name can be read as shell. Both windows stay open on failure long
# enough to read why.
cmd_terminal() {
  local what="$1" name="$2"
  need_container "$name"
  command -v omarchy-launch-terminal >/dev/null 2>&1 || die "no-terminal-launcher"
  case "$what" in
    logs)
      launch_detached omarchy-launch-terminal -- bash -c '
        podman logs -f --tail 200 "$1"
        status=$?
        [ $status -eq 130 ] && exit 0
        printf "\n\n— end of logs — press any key to close —"
        read -r -n1 -s
      ' _ "$name" ;;
    shell)
      [[ $(container_state "$name") == "running" ]] || die "container-not-running"
      launch_detached omarchy-launch-terminal -- bash -c '
        podman exec -it "$1" sh -c "if command -v bash >/dev/null 2>&1; then exec bash; else exec sh; fi"
        status=$?
        [ $status -eq 0 ] && exit 0
        printf "\n— the shell exited with status %s — press any key to close —" "$status"
        read -r -n1 -s
      ' _ "$name" ;;
    *) die "unknown-terminal-action" ;;
  esac
}

case "${1:-}" in
  list) cmd_list ;;
  stats) cmd_stats ;;
  start | stop | restart | pause | unpause | kill) cmd_lifecycle "$1" "${2:-}" "${3:-}" ;;
  remove) cmd_remove "${2:-}" ;;
  logs | shell) cmd_terminal "$1" "${2:-}" ;;
  open) cmd_open "${2:-}" "${3:-}" ;;
  connect) cmd_connect "${2:-}" "${3:-}" ;;
  viewer) cmd_viewer "${2:-}" ;;
  *)
    cat >&2 <<'USAGE'
usage: podman-ctl list | stats
       podman-ctl start|restart|pause|unpause|kill|remove <name>
       podman-ctl stop <name> [timeout]
       podman-ctl connect <name> [timeout] | viewer <name>
       podman-ctl logs|shell <name>
       podman-ctl open <name> <host-port>
USAGE
    exit 2
    ;;
esac
